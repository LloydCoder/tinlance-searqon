# Copy to .env and export values in your shell before running the app.
# This file contains placeholders only. Never commit real credentials.

NODE_ENV=development
HOST=127.0.0.1
PORT=4173

# Request-serving identity: non-owner, non-superuser, NOBYPASSRLS, member of searqon_app.
DATABASE_URL=postgresql://searqon_runtime:replace-me@127.0.0.1:5432/searqon
# Optional PEM CA bundle for managed PostgreSQL providers with a private trust root.
DATABASE_SSL_CA=

# Migration identity: dedicated schema/table owner with CREATEROLE; never use for app requests.
MIGRATION_DATABASE_URL=postgresql://searqon_migrator:replace-me@127.0.0.1:5432/searqon

PUBLIC_APP_ORIGIN=http://127.0.0.1:4173
# Replace with high-entropy output from: openssl rand -base64 32
AUTH_RATE_LIMIT_SECRET=replace-with-at-least-32-random-bytes

# Local-only magic-link delivery. Never enable console mode in production.
SEARQON_EMAIL_MODE=console
RESEND_API_KEY=
SEARQON_EMAIL_FROM=

# Dedicated billing ingestion identity. Configure only after a provider is approved.
# Must be a separate login granted searqon_billing_ingest; never reuse DATABASE_URL.
SEARQON_BILLING_INGEST_DATABASE_URL=postgresql://searqon_billing_ingest_login:replace-me@127.0.0.1:5432/searqon
# Dedicated billing worker identity; must be granted searqon_billing_worker.
SEARQON_BILLING_WORKER_DATABASE_URL=postgresql://searqon_billing_worker_login:replace-me@127.0.0.1:5432/searqon
SEARQON_BILLING_WORKER_ID=searqon-billing-worker-01

# Paddle Billing is recommended for global SaaS but remains disabled until seller onboarding and product-owner approval.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_NOTIFICATION_SECRET=
# JSON map from Paddle price IDs to Searqon paid plans. Never include API secrets here.
PADDLE_PRICE_PLAN_MAP_JSON={}
