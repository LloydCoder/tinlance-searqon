{
  "protocolVersion": "2026-07-28",
  "serverInfo": {
    "name": "Example Documentation MCP",
    "version": "1.0.0"
  },
  "capabilities": {
    "tools": {}
  },
  "tools": [
    {
      "name": "search_docs",
      "description": "Search the documentation corpus for relevant pages.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "query"
        ],
        "additionalProperties": false
      },
      "annotations": {
        "readOnlyHint": true,
        "destructiveHint": false,
        "idempotentHint": true,
        "openWorldHint": false
      }
    },
    {
      "name": "publish_update",
      "description": "Publish an approved documentation update.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "documentId": {
            "type": "string"
          },
          "content": {
            "type": "string"
          }
        },
        "required": [
          "documentId",
          "content"
        ]
      },
      "annotations": {
        "readOnlyHint": false,
        "destructiveHint": true,
        "idempotentHint": false,
        "openWorldHint": true
      }
    }
  ]
}
