{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.com/schemas/claim-defense-report.schema.json",
  "title": "Searqon Claim and Citation Defense Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "registryId",
    "registryContentDigest",
    "observedAt",
    "maxAgeDays",
    "summary",
    "results",
    "correctionManifest",
    "reportId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "const": "claim_defense_report"
    },
    "registryId": {
      "type": "string",
      "pattern": "^btr_[a-f0-9]{20}$"
    },
    "registryContentDigest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "observedAt": {
      "type": "string",
      "format": "date-time"
    },
    "maxAgeDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3650
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "totalClaims",
        "registryConsistent",
        "potentialContradictions",
        "unverified",
        "entityUnresolved",
        "disputed",
        "stale",
        "citationIssues"
      ],
      "properties": {
        "totalClaims": {
          "type": "integer",
          "minimum": 0
        },
        "registryConsistent": {
          "type": "integer",
          "minimum": 0
        },
        "potentialContradictions": {
          "type": "integer",
          "minimum": 0
        },
        "unverified": {
          "type": "integer",
          "minimum": 0
        },
        "disputed": {
          "type": "integer",
          "minimum": 0
        },
        "stale": {
          "type": "integer",
          "minimum": 0
        },
        "citationIssues": {
          "type": "integer",
          "minimum": 0
        },
        "entityUnresolved": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "results": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "claimId",
          "text",
          "matchedBrandTerm",
          "attribute",
          "claimedValue",
          "factId",
          "factStatus",
          "registryValue",
          "registryStatement",
          "assessment",
          "freshness",
          "ageDays",
          "confidence",
          "citationAssessment",
          "citations",
          "sourceUrls",
          "riskFlags"
        ],
        "properties": {
          "claimId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 5000
          },
          "matchedBrandTerm": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "attribute": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 96
          },
          "claimedValue": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "factId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          },
          "factStatus": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "owner_asserted",
              "corroborated",
              "disputed",
              "retired",
              null
            ]
          },
          "registryValue": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 512
          },
          "registryStatement": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 2048
          },
          "assessment": {
            "enum": [
              "registry_consistent",
              "potential_contradiction",
              "unverified",
              "disputed",
              "stale",
              "entity_unresolved"
            ]
          },
          "freshness": {
            "enum": [
              "unknown",
              "fresh",
              "stale",
              "future_dated"
            ]
          },
          "ageDays": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 0
          },
          "confidence": {
            "enum": [
              "none",
              "low",
              "medium",
              "high"
            ]
          },
          "citationAssessment": {
            "enum": [
              "missing_citation",
              "matched_registry_source",
              "citation_unverified",
              "attribution_swap"
            ]
          },
          "citations": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "sourceUrls": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            }
          },
          "riskFlags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            }
          }
        }
      }
    },
    "correctionManifest": {
      "$ref": "https://searqon.com/schemas/correction-manifest.schema.json"
    },
    "reportId": {
      "type": "string",
      "pattern": "^claim_report_[a-f0-9]{20}$"
    }
  }
}
