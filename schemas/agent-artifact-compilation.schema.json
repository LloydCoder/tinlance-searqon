{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.com/schemas/agent-artifact-compilation.schema.json",
  "title": "Searqon Agent Artifact Compilation Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "compilerVersion",
    "artifacts",
    "changes",
    "summary",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "const": "agent_artifact_compilation"
    },
    "compilerVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "artifacts": {
      "type": "array",
      "maxItems": 101,
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "changes": {
      "type": "array",
      "maxItems": 201,
      "items": {
        "$ref": "#/$defs/change"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactCount",
        "added",
        "modified",
        "unchanged",
        "removed",
        "patchesApplied"
      ],
      "properties": {
        "artifactCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 101
        },
        "added": {
          "type": "integer",
          "minimum": 0
        },
        "modified": {
          "type": "integer",
          "minimum": 0
        },
        "unchanged": {
          "type": "integer",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "minimum": 0
        },
        "patchesApplied": {
          "const": 0
        }
      }
    },
    "limitations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "mediaType",
        "content",
        "sha256",
        "provenance",
        "quality"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "kind": {
          "enum": [
            "markdown",
            "openapi",
            "derived"
          ]
        },
        "mediaType": {
          "type": "string"
        },
        "content": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "sourcePath",
            "sourceKind",
            "sourceSha256",
            "evidenceId",
            "methodologyVersion"
          ],
          "properties": {
            "sourceId": {
              "type": "string"
            },
            "sourcePath": {
              "type": [
                "string",
                "null"
              ]
            },
            "sourceKind": {
              "enum": [
                "markdown",
                "openapi",
                "derived"
              ]
            },
            "sourceSha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "evidenceId": {
              "type": [
                "string",
                "null"
              ]
            },
            "methodologyVersion": {
              "type": "string"
            }
          }
        },
        "quality": {
          "type": "object",
          "required": [
            "findings"
          ],
          "properties": {
            "summary": {
              "type": "object"
            },
            "observations": {
              "type": "object"
            },
            "assessments": {
              "type": "object"
            },
            "findings": {
              "type": "array"
            }
          }
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "status",
        "beforeSha256",
        "afterSha256",
        "unifiedDiff",
        "applied"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "status": {
          "enum": [
            "added",
            "modified",
            "unchanged",
            "removed"
          ]
        },
        "beforeSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "afterSha256": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[a-f0-9]{64}$"
        },
        "unifiedDiff": {
          "type": "string"
        },
        "applied": {
          "const": false
        }
      }
    }
  }
}
