{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.tinlance.com/schemas/evidence-legal-hold-journal-checkpoint/1.0.0",
  "title": "Searqon Evidence Legal Hold Journal Checkpoint",
  "description": "Detached Ed25519 checkpoint binding the legal-hold journal prefix length and head hash. The checkpoint key must be trusted independently.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "algorithm", "keyId", "entryCount", "headHash", "createdAt", "signature"],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "entryCount": { "type": "integer", "minimum": 0 },
    "headHash": { "oneOf": [{ "type": "null" }, { "type": "string", "pattern": "^[a-f0-9]{64}$" }] },
    "createdAt": { "type": "string", "format": "date-time" },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  },
  "allOf": [
    {
      "if": { "properties": { "entryCount": { "const": 0 } } },
      "then": { "properties": { "headHash": { "type": "null" } } },
      "else": { "properties": { "headHash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } } }
    }
  ]
}
