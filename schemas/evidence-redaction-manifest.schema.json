{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.tinlance.com/schemas/evidence-redaction-manifest/1.0.0",
  "title": "Searqon Evidence Redaction Manifest",
  "description": "Signed approval record for suppressing evidence identifiers from generated exports. It does not prove physical deletion or media sanitization.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "action",
    "algorithm",
    "keyId",
    "requestId",
    "reasonCode",
    "requestedBy",
    "approvedBy",
    "createdAt",
    "evidenceIds",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "action": {
      "const": "suppress_from_exports"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "keyId": {
      "type": "string",
      "pattern": "^ed25519:[a-f0-9]{64}$"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "reasonCode": {
      "type": "string",
      "enum": [
        "data_subject_request",
        "customer_request",
        "retention_expired",
        "incorrect_capture",
        "security_incident",
        "legal_requirement"
      ]
    },
    "requestedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "approvedBy": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:@-]*$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^evidence_[a-f0-9]{20}$"
      },
      "maxItems": 10000
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$",
      "minLength": 88,
      "maxLength": 88
    }
  }
}
