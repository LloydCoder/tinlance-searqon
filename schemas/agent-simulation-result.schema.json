{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinlance.com/schemas/searqon-agent-simulation-result-1.0.0.json",
  "title": "Searqon Agent Simulation Result",
  "description": "Deterministic, read-only snapshot journey output. It is not an evidence observation class, penetration-test result, or proof of live agent behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "runId", "mode", "targetEgress", "mutations", "inputSha256", "documents", "steps", "resultSha256"],
  "properties": {
    "version": { "const": 1 },
    "runId": { "type": ["string", "null"], "format": "uuid" },
    "mode": { "const": "read_only_snapshot_simulation" },
    "targetEgress": { "const": "none" },
    "mutations": { "const": "disabled" },
    "inputSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "resultSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "documents": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "path", "contentType", "bytes", "sha256"],
        "properties": {
          "id": { "type": "string", "maxLength": 64 },
          "path": { "type": "string", "maxLength": 2048 },
          "contentType": { "enum": ["text/html", "text/markdown", "text/plain", "application/json"] },
          "bytes": { "type": "integer", "minimum": 0, "maximum": 8192 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "steps": {
      "type": "array",
      "maxItems": 30,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["index", "action", "status", "result"],
        "properties": {
          "index": { "type": "integer", "minimum": 0, "maximum": 29 },
          "action": { "enum": ["discover", "read_document", "follow_link", "inspect_openapi", "inspect_mcp_snapshot"] },
          "status": { "enum": ["completed", "blocked"] },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": ["documentId", "sourcePath"],
            "properties": {
              "documentId": { "type": "string", "maxLength": 64 },
              "sourcePath": { "type": "string", "maxLength": 2048 },
              "contentSha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
            }
          },
          "result": { "type": "object" }
        }
      }
    }
  }
}
