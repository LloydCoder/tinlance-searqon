{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinlance.com/schemas/evidence-ledger-checkpoint-1.0.0.json",
  "title": "Searqon Signed Evidence Ledger Checkpoint",
  "description": "Detached Ed25519 signature over an evidence ledger root. The checkpoint is only an external anchor if stored separately from the ledger; createdAt is not a trusted timestamp.",
  "type": "object",
  "required": [
    "schemaVersion",
    "algorithm",
    "keyId",
    "ledgerSchemaVersion",
    "entryCount",
    "headSequence",
    "headHash",
    "createdAt",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "keyId": {
      "type": "string",
      "pattern": "^ed25519:[a-f0-9]{64}$"
    },
    "ledgerSchemaVersion": {
      "const": "1.0.0"
    },
    "entryCount": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headSequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "headHash": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{64}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "signature": {
      "type": "string",
      "contentEncoding": "base64",
      "minLength": 88,
      "maxLength": 88
    }
  },
  "additionalProperties": false
}
