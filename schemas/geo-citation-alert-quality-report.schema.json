{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.com/schemas/geo-citation-alert-quality-report.schema.json",
  "title": "Searqon GEO citation alert quality report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "evaluationMethod",
    "labelSource",
    "caseCount",
    "counts",
    "metrics",
    "cases"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "const": "geo_citation_alert_quality_report"
    },
    "evaluationMethod": {
      "const": "caller_labelled_domain_disappearance"
    },
    "labelSource": {
      "const": "caller_supplied"
    },
    "caseCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "counts": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "truePositive",
        "falsePositive",
        "falseNegative",
        "trueNegative"
      ],
      "properties": {
        "truePositive": {
          "type": "integer",
          "minimum": 0
        },
        "falsePositive": {
          "type": "integer",
          "minimum": 0
        },
        "falseNegative": {
          "type": "integer",
          "minimum": 0
        },
        "trueNegative": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "precision",
        "recall",
        "specificity",
        "falsePositiveRate",
        "f1"
      ],
      "properties": {
        "precision": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "recall": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "specificity": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "falsePositiveRate": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "f1": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "caseId",
          "truePositive",
          "falsePositive",
          "falseNegative",
          "trueNegative",
          "predictedDomains",
          "expectedDisappearedDomains",
          "observationLagSeconds",
          "observationFreshness"
        ],
        "properties": {
          "caseId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "truePositive": {
            "type": "integer",
            "minimum": 0
          },
          "falsePositive": {
            "type": "integer",
            "minimum": 0
          },
          "falseNegative": {
            "type": "integer",
            "minimum": 0
          },
          "trueNegative": {
            "type": "integer",
            "minimum": 0
          },
          "predictedDomains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "expectedDisappearedDomains": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "observationLagSeconds": {
            "type": "integer",
            "minimum": 0
          },
          "observationFreshness": {
            "enum": [
              "fresh",
              "stale"
            ]
          }
        }
      }
    }
  }
}
