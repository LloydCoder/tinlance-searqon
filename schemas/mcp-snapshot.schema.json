{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tinlance.com/schemas/searqon-mcp-snapshot-1.1.0.json",
  "title": "Searqon MCP Metadata Snapshot",
  "description": "Normalized caller-supplied MCP metadata for passive analysis. This is an import contract, not a wire-level MCP response schema. MCP 2026-07-28 tools/list cache metadata is represented by toolsListMetadata.",
  "type": "object",
  "required": [
    "tools"
  ],
  "properties": {
    "protocolVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "toolsListMetadata": {
      "type": "object",
      "required": [
        "resultType",
        "ttlMs",
        "cacheScope"
      ],
      "properties": {
        "resultType": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "ttlMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cacheScope": {
          "type": "string",
          "enum": [
            "public",
            "private"
          ]
        }
      },
      "additionalProperties": false
    },
    "serverInfo": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      },
      "additionalProperties": true
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true
    },
    "tools": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "name",
          "inputSchema"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9_.-]+$"
          },
          "description": {
            "type": "string",
            "maxLength": 4096
          },
          "inputSchema": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "object"
              }
            },
            "additionalProperties": true
          },
          "outputSchema": {
            "type": "object"
          },
          "annotations": {
            "type": "object",
            "properties": {
              "readOnlyHint": {
                "type": "boolean"
              },
              "destructiveHint": {
                "type": "boolean"
              },
              "idempotentHint": {
                "type": "boolean"
              },
              "openWorldHint": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        },
        "additionalProperties": true
      }
    },
    "_meta": {
      "type": "object",
      "properties": {
        "io.modelcontextprotocol/protocolVersion": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "io.modelcontextprotocol/serverInfo": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "additionalProperties": true
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
