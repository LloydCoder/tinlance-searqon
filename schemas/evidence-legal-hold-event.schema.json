{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.tinlance.com/schemas/evidence-legal-hold-event/1.0.0",
  "title": "Searqon Evidence Legal Hold Event",
  "description": "Signed, ordered legal-hold placement or release event. Signature validity does not authenticate the human actor identity; key custody and authorization remain external.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "algorithm",
    "keyId",
    "holdId",
    "sequence",
    "action",
    "requestId",
    "reasonCode",
    "requestedBy",
    "approvedBy",
    "createdAt",
    "evidenceIds",
    "signature"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0.0" },
    "algorithm": { "const": "Ed25519" },
    "keyId": { "type": "string", "pattern": "^ed25519:[a-f0-9]{64}$" },
    "holdId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "sequence": { "type": "integer", "minimum": 1 },
    "action": { "enum": ["place", "release"] },
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "reasonCode": { "enum": ["litigation", "regulatory", "investigation", "contractual", "security_incident"] },
    "requestedBy": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "approvedBy": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "createdAt": { "type": "string", "format": "date-time" },
    "evidenceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10000,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^evidence_[a-f0-9]{20}$" }
    },
    "signature": { "type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$" }
  }
}
