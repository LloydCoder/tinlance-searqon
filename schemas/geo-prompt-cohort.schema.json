{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.com/schemas/geo-prompt-cohort.schema.json",
  "title": "Searqon GEO Prompt Cohort",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "cohortId",
    "registryId",
    "brand",
    "locale",
    "market",
    "createdAt",
    "prompts"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "const": "geo_prompt_cohort"
    },
    "cohortId": {
      "type": "string",
      "pattern": "^cohort_[a-f0-9]{20}$"
    },
    "registryId": {
      "type": "string",
      "pattern": "^btr_[a-f0-9]{20}$"
    },
    "brand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "primaryDomain"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "primaryDomain": {
          "type": "string",
          "maxLength": 253
        }
      }
    },
    "locale": {
      "type": "string",
      "minLength": 2,
      "maxLength": 35
    },
    "market": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[A-Z]{2,3}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "prompts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "promptId",
          "prompt",
          "intent",
          "journeyStage",
          "locale"
        ],
        "properties": {
          "promptId": {
            "type": "string",
            "pattern": "^prompt_[a-f0-9]{20}$"
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "intent": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "journeyStage": {
            "enum": [
              "awareness",
              "consideration",
              "decision",
              "retention",
              "other"
            ]
          },
          "locale": {
            "type": "string",
            "minLength": 2,
            "maxLength": 35
          }
        }
      }
    }
  }
}
