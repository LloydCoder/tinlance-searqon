{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://searqon.com/schemas/geo-sampling-plan.schema.json",
  "title": "Searqon GEO Sampling Plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "cohortId",
    "registryId",
    "createdAt",
    "sampleCount",
    "costCapUsd",
    "estimatedCostUsd",
    "providers",
    "tasks",
    "planId"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "type": {
      "const": "geo_sampling_plan"
    },
    "cohortId": {
      "type": "string",
      "pattern": "^cohort_[a-f0-9]{20}$"
    },
    "registryId": {
      "type": "string",
      "pattern": "^btr_[a-f0-9]{20}$"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "sampleCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 20
    },
    "costCapUsd": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 100000
    },
    "estimatedCostUsd": {
      "type": "number",
      "minimum": 0
    },
    "providers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "observationClass",
          "collectionMode",
          "adapterId",
          "policyReview",
          "estimatedCostPerSampleUsd",
          "maxSamples"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observationClass": {
            "enum": [
              "consumer_observation",
              "model_api"
            ]
          },
          "collectionMode": {
            "enum": [
              "manual_capture",
              "official_api"
            ]
          },
          "adapterId": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 128
          },
          "policyReview": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "status",
              "reviewedAt",
              "reviewerId",
              "sourceUrl"
            ],
            "properties": {
              "status": {
                "const": "approved"
              },
              "reviewedAt": {
                "type": "string",
                "format": "date-time"
              },
              "reviewerId": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "sourceUrl": {
                "type": "string",
                "format": "uri",
                "pattern": "^https://"
              }
            }
          },
          "estimatedCostPerSampleUsd": {
            "type": "number",
            "minimum": 0,
            "maximum": 1000
          },
          "maxSamples": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "taskId",
          "providerName",
          "observationClass",
          "collectionMode",
          "promptId",
          "sampleIndex",
          "estimatedCostUsd",
          "status"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "pattern": "^sample_[a-f0-9]{20}$"
          },
          "providerName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "observationClass": {
            "enum": [
              "consumer_observation",
              "model_api"
            ]
          },
          "collectionMode": {
            "enum": [
              "manual_capture",
              "official_api"
            ]
          },
          "promptId": {
            "type": "string",
            "pattern": "^prompt_[a-f0-9]{20}$"
          },
          "sampleIndex": {
            "type": "integer",
            "minimum": 1,
            "maximum": 20
          },
          "estimatedCostUsd": {
            "type": "number",
            "minimum": 0
          },
          "status": {
            "const": "planned"
          }
        }
      }
    },
    "planId": {
      "type": "string",
      "pattern": "^sampling_[a-f0-9]{20}$"
    }
  }
}
